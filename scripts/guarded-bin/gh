#!/usr/bin/env node

import { spawnSync } from 'node:child_process';
import { dirname, delimiter, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const args = process.argv.slice(2);
const ownDir = dirname(fileURLToPath(import.meta.url));
const CENSUS_PATH = 'docs/harness-feedback/registry/measurement-bundles.yaml';

const VALUE_OPTION_ALIASES = Object.freeze({
  repository: Object.freeze(['--repo', '-R']),
  title: Object.freeze(['--title', '-t']),
  head: Object.freeze(['--head', '-H']),
  base: Object.freeze(['--base', '-B']),
});

function valueOptionAt(index, names) {
  const arg = args[index];
  if (names.includes(arg)) {
    return { value: args[index + 1], width: args[index + 1] === undefined ? 1 : 2 };
  }
  for (const name of names) {
    const prefix = `${name}=`;
    if (arg.startsWith(prefix)) return { value: arg.slice(prefix.length), width: 1 };
    if (/^-[^-]$/.test(name) && arg.startsWith(name) && arg.length > name.length) {
      return { value: arg.slice(name.length), width: 1 };
    }
  }
  return undefined;
}

function optionValues(option) {
  const names = VALUE_OPTION_ALIASES[option];
  const values = [];
  for (let index = 0; index < args.length; index += 1) {
    const parsed = valueOptionAt(index, names);
    if (!parsed) continue;
    if (parsed.value !== undefined) values.push(parsed.value);
    index += parsed.width - 1;
  }
  return values;
}

function optionValue(option) {
  return optionValues(option).at(-1);
}

function commandArgs() {
  let index = 0;
  while (index < args.length) {
    const arg = args[index];
    const repository = valueOptionAt(index, VALUE_OPTION_ALIASES.repository);
    if (repository) {
      index += repository.width;
      continue;
    }
    const hostname = valueOptionAt(index, ['--hostname']);
    if (hostname) {
      index += hostname.width;
      continue;
    }
    if (arg === 'pr') {
      index += 1;
      while (index < args.length) {
        const inheritedRepository = valueOptionAt(index, VALUE_OPTION_ALIASES.repository);
        if (!inheritedRepository) break;
        index += inheritedRepository.width;
      }
      return ['pr', ...args.slice(index)];
    }
    if (!arg.startsWith('-')) return args.slice(index);
    index += 1;
  }
  return [];
}

function gitOutput(gitArgs) {
  const result = spawnSync('git', gitArgs, { encoding: 'utf8' });
  return result.status === 0 ? result.stdout.trim() : '';
}

function candidateBaseRef() {
  const baseBranch = optionValue('base') ?? 'main';
  const remoteBase = `refs/remotes/origin/${baseBranch}`;
  return gitOutput(['rev-parse', '--verify', remoteBase]) ? remoteBase : baseBranch;
}

function candidateChangedPaths() {
  const paths = gitOutput(['diff', '--name-only', `${candidateBaseRef()}...HEAD`]);
  return paths ? paths.split('\n') : [];
}

function parseCensusEntries(content) {
  const matches = [...content.matchAll(/^  - domainId:\s*([^\s#]+)\s*$/gm)];
  if (matches.length === 0) return undefined;
  const entries = new Map();
  for (const [index, match] of matches.entries()) {
    const domainId = match[1];
    if (entries.has(domainId)) return undefined;
    entries.set(domainId, content.slice(match.index, matches[index + 1]?.index ?? content.length));
  }
  return { prefix: content.slice(0, matches[0].index), entries };
}

function hasExactlyOne(block, pattern) {
  return [...block.matchAll(pattern)].length === 1;
}

function isSafeBootstrapEntry(block) {
  return [
    /^    committedVerdictArtifactCount:\s*0\s*$/gm,
    /^    validityMigration:\s*$/gm,
    /^      status:\s*unmigrated\s*$/gm,
    /^      certificateRef:\s*null\s*$/gm,
    /^      resultRef:\s*null\s*$/gm,
    /^      replayRef:\s*null\s*$/gm,
    /^      actionGate:\s*keep_observe_only\s*$/gm,
  ].every((pattern) => hasExactlyOne(block, pattern));
}

function isCensusBootstrapOnly() {
  const baseRef = candidateBaseRef();
  const diff = spawnSync(
    'git',
    ['diff', '--unified=0', '--no-color', `${baseRef}...HEAD`, '--', CENSUS_PATH],
    { encoding: 'utf8' },
  );
  if (diff.status !== 0 || !diff.stdout) return false;
  if (diff.stdout.split('\n').some((line) => line.startsWith('-') && !line.startsWith('---'))) return false;

  const base = spawnSync('git', ['show', `${baseRef}:${CENSUS_PATH}`], { encoding: 'utf8' });
  const head = spawnSync('git', ['show', `HEAD:${CENSUS_PATH}`], { encoding: 'utf8' });
  if (base.status !== 0 || head.status !== 0) return false;
  const baseCensus = parseCensusEntries(base.stdout);
  const headCensus = parseCensusEntries(head.stdout);
  if (!baseCensus || !headCensus || baseCensus.prefix !== headCensus.prefix) return false;

  for (const [domainId, block] of baseCensus.entries) {
    if (headCensus.entries.get(domainId) !== block) return false;
  }
  const addedEntries = [...headCensus.entries].filter(([domainId]) => !baseCensus.entries.has(domainId));
  return addedEntries.length > 0 && addedEntries.every(([, block]) => isSafeBootstrapEntry(block));
}

function fail(code, detail) {
  process.stderr.write(`${code}: ${detail}\n`);
  process.exit(1);
}

const command = commandArgs();
if (command[0] === 'pr' && ['create', 'new'].includes(command[1])) {
  const title = optionValue('title') ?? '';
  const head = optionValue('head') ?? '';
  const branch = gitOutput(['branch', '--show-current']);
  const commitSubject = gitOutput(['log', '-1', '--pretty=%s']);
  const changedPaths = candidateChangedPaths();
  const touchesRetiredArtifacts = changedPaths.some(
    (path) =>
      path.startsWith('docs/harness-feedback/bundles/') ||
      path.startsWith('docs/harness-feedback/verdicts/'),
  );
  if (
    title.startsWith('verdict(') ||
    head.includes('verdict/auto/') ||
    branch.startsWith('verdict/auto/') ||
    commitSubject.startsWith('verdict(') ||
    touchesRetiredArtifacts
  ) {
    fail(
      'verdict_git_publication_retired',
      'runtime verdict evidence is durable artifact-store data; publish through cat_cafe_publish_verdict',
    );
  }
  if (changedPaths.includes(CENSUS_PATH) && !isCensusBootstrapOnly()) {
    fail(
      'verdict_census_bootstrap_only',
      'Git census changes may only append new fail-closed domains with zero artifacts, unmigrated status, null evidence refs, and keep_observe_only',
    );
  }
}

const delegatePath = (process.env.PATH ?? '')
  .split(delimiter)
  .filter((entry) => entry && resolve(entry) !== resolve(ownDir))
  .join(delimiter);
const delegate = process.env.CAT_CAFE_REAL_GH_PATH ?? 'gh';
const result = spawnSync(delegate, args, {
  env: { ...process.env, PATH: delegatePath },
  stdio: 'inherit',
});
if (result.error) fail('gh_delegate_failed', result.error.message);
if (result.signal) process.kill(process.pid, result.signal);
process.exit(result.status ?? 1);
