{
  "name": "@cat-cafe/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node ./scripts/prepare-secret-runtime.mjs && tsc",
    "dev": "node ./scripts/prepare-secret-runtime.mjs && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "node ../../scripts/clean-path.mjs dist",
    "lint": "node ./scripts/prepare-secret-runtime.mjs && tsc --noEmit",
    "governance:write": "node ./scripts/prepare-secret-runtime.mjs && tsc && node dist/tool-governance-cli.js write",
    "governance:check": "pnpm run build && node dist/tool-governance-cli.js check",
    "test": "pnpm run build && node --import ./test/helpers/isolate-callback-outbox.mjs --import tsx --test test/*.test.js test/*.test.ts"
  },
  "dependencies": {
    "@cat-cafe/finance": "workspace:*",
    "@cat-cafe/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
