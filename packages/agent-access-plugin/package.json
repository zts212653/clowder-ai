{
  "name": "@clowder-ai/agent-access",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./manifest.json": "./manifest.json",
    "./discovery/*": {
      "types": "./dist/discovery/*.d.ts",
      "import": "./dist/discovery/*.js"
    },
    "./roles/*": {
      "types": "./dist/roles/*.d.ts",
      "import": "./dist/roles/*.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*.js"
    },
    "./workstation/*": {
      "types": "./dist/workstation/*.d.ts",
      "import": "./dist/workstation/*.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs && node scripts/pack.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@cat-cafe/shared": "workspace:*",
    "@clowder-ai/agent-contract": "workspace:*",
    "smol-toml": "^1.6.0",
    "yaml": "^2.8.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "0.27.2",
    "typescript": "^5.3.3"
  }
}
