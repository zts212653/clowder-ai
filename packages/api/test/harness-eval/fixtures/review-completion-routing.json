{
  "schemaVersion": 1,
  "metricBirthCertificate": {
    "utilityClaim": "A passing replay means review entry and completion follow author and custody provenance: formal external reviews cannot privately suppress GitHub delivery, advisory scans cannot claim review completion, and local-cat reviews return to the author with exact evidence.",
    "estimator": "Deterministic paired replay over one positive and one counterfactual for each entry mode and completion route; count intent, entry, and completion mismatches without weighting them together.",
    "validityBounds": "Covers review tasks and trackers with explicit author kind, custody, handoff source, exact revision, entry kind, and bilingual no-comment directives represented by the frozen cases. Unknown or contradictory provenance fails closed; euphemisms outside the directive matcher require a new escaped-incident fixture.",
    "consumer": "pnpm check:review-completion-routing blocks a change that regresses either side of the route pair; the eval:external-case-closure owner consumes new real incidents by adding a counterfactual pair.",
    "calibrationPlan": "Recalibrate whenever a real review-routing incident escapes or a legitimate advisory/local handoff is falsely blocked. V1 rejects explicit EN/CN review-artifact suppression verbs, but deliberately does not treat bare 'no GitHub' or a lone Chinese negation as a ban; add the escaped case and its opposite-route counterfactual before changing that boundary.",
    "repeatabilityContract": "Discovery and acceptance use separate cases in each pair; inputs and expected verdicts are frozen JSON, the evaluator is deterministic, and repeated runs must be byte-for-byte stable.",
    "sunsetPolicy": "Keep the entry guard while formal external review can create a tracker or completion artifact. Tune directive vocabulary on false blocks; sunset only if a typed runtime contract makes contradictory task and tracker instructions unrepresentable.",
    "runtimeBoundary": "This V1 hard guard runs in the checked-in review-routing check chain; the live register_pr_tracking mutation path remains description-governed until a typed runtime contract makes contradictory instructions unrepresentable."
  },
