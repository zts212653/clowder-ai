{
  "pluginId": "official.chatgpt-dot",
  "version": "0.2.0-alpha.30",
  "contractVersion": "0.3.3-candidate.1",
  "name": "ChatGPT Dot",
  "description": {
    "default": "将已配对的 ChatGPT Dot 接入对话，回复与原图回到召唤来源。",
    "translations": {
      "en": "Connect a paired ChatGPT Dot and return source-bound replies and original images."
    }
  },
  "icon": {
    "type": "svg",
    "src": "assets/chatgpt-cloud.svg"
  },
  "call": {
    "alias": "dot",
    "displayName": "Dot"
  },
  "steps": [
    {
      "text": "选择长期或临时公网入口，点击「生成 Server URL」或「创建临时入口」，复制返回的 Server URL。"
    },
    {
      "text": "打开 https://chatgpt.com/plugins，选择「+」→「Add custom MCP server」，粘贴 Server URL，将 Authentication 设为「No authentication」，并记住添加时使用的插件名称。"
    },
    {
      "text": "在刚添加的插件详情中确认已显示 Dot 工具和 dot.summoned 事件；只有未显示或工具与事件定义更新后，才点击 Refresh 重新扫描。"
    },
    {
      "text": "点击「生成订阅消息」并复制结果。打开 https://chatgpt.com 并切换到 Work，在目标对话中输入 @，选择刚添加的插件，再粘贴消息并发送，按 ChatGPT 提示允许订阅。"
    },
    {
      "text": "回到「Dot 连接」等待订阅结果。连接建立后发起往返测试；只有读取原消息并回复校验码成功才显示可用，此后可在 Clowder AI 对话中 @dot 发送消息。"
    }
  ],
  "configuration": [
    {
      "key": "endpointMode",
      "label": "ChatGPT 入口类型",
      "kind": "select",
      "required": true,
      "default": "temporary",
      "options": [
        {
          "value": "long-lived",
          "label": "长期公网入口"
        },
        {
          "value": "temporary",
          "label": "临时公网入口"
        }
      ],
      "description": "选择已有的长期公网入口，或让 Dot 自动创建最长 24 小时的临时入口。"
    },
    {
      "key": "longLivedServerUrlTemplate",
      "label": "长期公网入口地址",
      "kind": "string",
      "required": true,
      "description": "指向 Host 通用插件转发路径的完整 HTTPS URL，必须且只能包含一次 {token}；例如 https://host.example/api/plugin-runtime/handle?token={token}。"
    },
    {
      "key": "externalTokenDays",
      "label": "外部凭据有效天数",
      "kind": "number",
      "required": false,
      "default": 180,
      "description": "1–180 天；Dot 会在到期前提示更新。"
    },
    {
      "key": "temporaryEndpointHours",
      "label": "临时入口有效小时数",
      "kind": "number",
      "required": false,
      "default": 1,
      "description": "最长 24 小时；到期、重启、停用或卸载都会关闭。新 URL 需在 ChatGPT 重新添加连接。"
    },
    {
      "key": "longLivedEndpoint",
      "label": "Server URL（长期入口）",
      "description": "生成后复制 URL，按上方第 2、3 步添加到 ChatGPT 并确认工具与事件。",
      "kind": "operation",
      "required": false,
      "target": ["longLivedServerUrlTemplate"],
      "actions": [
        {
          "id": "use-long-lived",
          "label": "生成 Server URL",
          "render": "button",
          "resultRender": "text",
          "confirm": "生成或显示当前 Server URL？有效入口会被复用。",
          "action": {
            "method": "dot.use-long-lived"
          }
        }
      ]
    },
    {
      "key": "temporaryEndpoint",
      "label": "Server URL（临时入口）",
      "description": "创建后复制 URL，按上方第 2、3 步添加到 ChatGPT 并确认工具与事件。",
      "kind": "operation",
      "required": false,
      "actions": [
        {
          "id": "start-temporary",
          "label": "创建临时入口",
          "render": "button",
          "resultRender": "text",
          "confirm": "确认启动一个有时限的临时公网入口？",
          "action": {
            "method": "dot.start-temporary"
          }
        }
      ]
    },
    {
      "key": "webhookProxyUrl",
      "label": "回调代理（可选）",
      "kind": "string",
      "required": false,
      "description": "仅支持本机 HTTP CONNECT 代理；留空直接连接。保存后更新连接。"
    },
    {
      "key": "subscription",
      "label": "订阅消息",
      "description": "在目标 ChatGPT Work 对话中输入 @ 选择刚添加的插件，粘贴生成的消息并发送，允许订阅。",
      "kind": "operation",
      "required": false,
      "actions": [
        {
          "id": "show-instructions",
          "label": "生成订阅消息",
          "render": "button",
          "resultRender": "text",
          "action": {
            "method": "dot.show-instructions"
          }
        }
      ]
    },
    {
      "key": "connection",
      "label": "Dot 连接",
      "kind": "operation",
      "required": false,
      "actions": [
        {
          "id": "status",
          "label": "刷新状态",
          "render": "status",
          "resultRender": "rows",
          "action": {
            "method": "dot.status"
          }
        },
        {
          "id": "show-server-url",
          "label": "显示并复制 Server URL",
          "render": "row",
          "resultRender": "text",
          "action": {
            "method": "dot.show-server-url"
          }
        },
        {
          "id": "refresh-credential",
          "label": "更新外部凭据",
          "render": "row",
          "resultRender": "text",
          "confirm": "确认签发并验证新的外部凭据？现有凭据会保留到新凭据验证成功。",
          "action": {
            "method": "dot.refresh-credential"
          }
        },
        {
          "id": "cancel-pending",
          "label": "放弃本次更新",
          "render": "row",
          "resultRender": "rows",
          "confirm": "放弃待验证的新凭据并关闭对应临时入口？现有凭据不会被替换。",
          "action": {
            "method": "dot.cancel-pending"
          }
        },
        {
          "id": "begin-pairing",
          "label": "准备连接",
          "render": "row",
          "resultRender": "rows",
          "confirm": "准备连接目标 ChatGPT Work 对话？有效连接信息会被复用。",
          "action": {
            "method": "dot.begin-pairing"
          }
        },
        {
          "id": "reconnect",
          "label": "重置连接",
          "render": "row",
          "resultRender": "rows",
          "confirm": "这会撤销旧配对，旧召唤将不能继续回复。",
          "action": {
            "method": "dot.reconnect"
          }
        },
        {
          "id": "disconnect",
          "label": "断开连接",
          "render": "row",
          "resultRender": "rows",
          "confirm": "断开后无法接收召唤，已保存的消息和原图保留。",
          "action": {
            "method": "dot.disconnect"
          }
        },
        {
          "id": "roundtrip",
          "label": "发起往返测试",
          "render": "row",
          "resultRender": "rows",
          "action": {
            "method": "dot.roundtrip"
          }
        },
        {
          "id": "check-roundtrip",
          "label": "检查测试结果",
          "render": "row",
          "resultRender": "rows",
          "action": {
            "method": "dot.check-roundtrip"
          }
        }
      ]
    }
  ],
  "configurationVariants": {
    "discriminator": "endpointMode",
    "branches": [
      {
        "id": "long-lived",
        "when": {
          "properties": {
            "endpointMode": {
              "const": "long-lived"
            }
          }
        },
        "fields": ["longLivedServerUrlTemplate", "externalTokenDays", "longLivedEndpoint"]
      },
      {
        "id": "temporary",
        "when": {
          "properties": {
            "endpointMode": {
              "const": "temporary"
            }
          }
        },
        "fields": ["temporaryEndpointHours", "temporaryEndpoint"]
      }
    ]
  },
  "test": {
    "action": {
      "method": "dot.test"
    }
  },
  "contributions": [
    {
      "type": "identity",
      "id": "dot",
      "displayName": "Dot"
    },
    {
      "type": "webhook",
      "id": "dot-original",
      "path": "images/:imageId",
      "methods": ["GET"]
    },
    {
      "type": "media-source",
      "id": "dot-images",
      "binding": "dot"
    },
    {
      "type": "external-request",
      "id": "dot-mcp"
    }
  ],
  "features": [
    {
      "id": "dot-connection",
      "name": "Dot 配对与对话",
      "resources": [],
      "contributions": [
        {
          "type": "identity",
          "id": "dot"
        },
        {
          "type": "webhook",
          "id": "dot-original"
        },
        {
          "type": "media-source",
          "id": "dot-images"
        },
        {
          "type": "external-request",
          "id": "dot-mcp"
        }
      ],
      "capabilities": [
        "plugin.config.read",
        "plugin.state.get",
        "plugin.state.set",
        "messaging.send",
        "message.event.subscribe",
        "streams.read",
        "thread.listMetadata",
        "thread.readContent",
        "thread.write"
      ]
    }
  ],
  "data": [
    {
      "name": "dot-connection",
      "dataClass": "relationship",
      "strategy": "retained",
      "schemaVersion": "1"
    },
    {
      "name": "dot-dispatch",
      "dataClass": "interaction-history",
      "strategy": "retained",
      "schemaVersion": "1"
    },
    {
      "name": "dot-images",
      "dataClass": "derived-user-visible",
      "strategy": "retained",
      "schemaVersion": "1"
    }
  ],
  "runtime": {
    "transport": "builtin",
    "entrypoint": "dist/plugin-entrypoint.js"
  }
}
