{
  "pluginId": "official.chatgpt-dot",
  "version": "0.2.0-alpha.9",
  "contractVersion": "0.3.1-candidate.1",
  "name": "ChatGPT Dot",
  "description": {
    "default": "将已配对的 ChatGPT Dot 接入对话，回复与原图回到召唤来源。",
    "translations": {
      "en": "Connect a paired ChatGPT Dot and return source-bound replies and original images."
    }
  },
  "icon": {
    "type": "svg",
    "src": "assets/chatgpt-cloud.svg"
  },
  "call": {
    "alias": "dot",
    "displayName": "Dot"
  },
  "steps": [
    {
      "text": "Dot 复用本实例已有的猫咖云端连接，不要求新建或修改第二条连接。"
    },
    {
      "text": "连接设置会按当前真实状态只显示下一步；授权、生成配对和重新配对都需要主人明确操作。"
    },
    {
      "text": "ChatGPT 订阅后发起真实往返测试；页面确认读取原消息并收到校验回复后才显示可用。"
    }
  ],
  "configuration": [
    {
      "key": "webhookProxyUrl",
      "label": "回调代理（可选）",
      "kind": "string",
      "required": false,
      "description": "仅支持本机 HTTP CONNECT 代理；留空直接连接。保存后更新连接。"
    },
    {
      "key": "connection",
      "label": "Dot 连接",
      "kind": "operation",
      "required": false,
      "actions": [
        {
          "id": "status",
          "label": "刷新状态",
          "render": "status",
          "resultRender": "rows",
          "action": {
            "method": "dot.status"
          }
        },
        {
          "id": "prepare-shared",
          "label": "准备授权",
          "render": "row",
          "resultRender": "rows",
          "action": {
            "method": "dot.prepare-shared"
          }
        },
        {
          "id": "begin-pairing",
          "label": "生成配对说明",
          "render": "row",
          "resultRender": "rows",
          "confirm": "确认生成一次新的 Dot 配对说明？",
          "action": {
            "method": "dot.begin-pairing"
          }
        },
        {
          "id": "show-instructions",
          "label": "复制配对说明",
          "render": "row",
          "action": {
            "method": "dot.show-instructions"
          }
        },
        {
          "id": "reconnect",
          "label": "重新生成配对说明",
          "render": "row",
          "resultRender": "rows",
          "confirm": "这会撤销旧配对，旧召唤将不能继续回复。",
          "action": {
            "method": "dot.reconnect"
          }
        },
        {
          "id": "disconnect",
          "label": "断开连接",
          "render": "row",
          "resultRender": "rows",
          "confirm": "断开后无法接收召唤，已保存的消息和原图保留。",
          "action": {
            "method": "dot.disconnect"
          }
        },
        {
          "id": "roundtrip",
          "label": "发起往返测试",
          "render": "row",
          "resultRender": "rows",
          "action": {
            "method": "dot.roundtrip"
          }
        },
        {
          "id": "check-roundtrip",
          "label": "检查测试结果",
          "render": "row",
          "resultRender": "rows",
          "action": {
            "method": "dot.check-roundtrip"
          }
        },
        {
          "id": "bind-shared",
          "label": "连接现有猫咖云端连接",
          "render": "row",
          "resultRender": "rows",
          "confirm": "确认将这个安装公开的工具与事件接入现有猫咖云端连接？",
          "action": {
            "method": "dot.bind-shared"
          }
        }
      ]
    }
  ],
  "test": {
    "action": {
      "method": "dot.test"
    }
  },
  "contributions": [
    {
      "type": "identity",
      "id": "dot",
      "displayName": "Dot"
    },
    {
      "type": "webhook",
      "id": "dot-original",
      "path": "images/:imageId",
      "methods": ["GET"]
    },
    {
      "type": "media-source",
      "id": "dot-images",
      "binding": "dot"
    }
  ],
  "features": [
    {
      "id": "dot-connection",
      "name": "Dot 配对与对话",
      "resources": [],
      "contributions": [
        {
          "type": "identity",
          "id": "dot"
        },
        {
          "type": "webhook",
          "id": "dot-original"
        },
        {
          "type": "media-source",
          "id": "dot-images"
        }
      ],
      "capabilities": [
        "plugin.config.read",
        "plugin.state.get",
        "plugin.state.set",
        "messaging.send",
        "message.event.subscribe",
        "streams.read",
        "thread.listMetadata",
        "thread.readContent",
        "thread.write"
      ]
    }
  ],
  "data": [
    {
      "name": "dot-connection",
      "dataClass": "relationship",
      "strategy": "retained",
      "schemaVersion": "1"
    },
    {
      "name": "dot-dispatch",
      "dataClass": "interaction-history",
      "strategy": "retained",
      "schemaVersion": "1"
    },
    {
      "name": "dot-images",
      "dataClass": "derived-user-visible",
      "strategy": "retained",
      "schemaVersion": "1"
    }
  ],
  "runtime": {
    "transport": "builtin",
    "entrypoint": "dist/plugin-entrypoint.js"
  }
}
