{
  "pluginId": "official.chatgpt-dot",
  "version": "0.2.0-alpha.15",
  "contractVersion": "0.3.1-candidate.3",
  "name": "ChatGPT Dot",
  "description": {
    "default": "将已配对的 ChatGPT Dot 接入对话，回复与原图回到召唤来源。",
    "translations": {
      "en": "Connect a paired ChatGPT Dot and return source-bound replies and original images."
    }
  },
  "icon": {
    "type": "svg",
    "src": "assets/chatgpt-cloud.svg"
  },
  "call": {
    "alias": "dot",
    "displayName": "Dot"
  },
  "steps": [
    {
      "text": "先选择长期公网入口，或让 Dot 自动创建最长 24 小时的临时入口；无需终端命令。"
    },
    {
      "text": "把页面显示的 Server URL 添加到 ChatGPT；真实 discovery 到达后，页面才进入 Dot 配对。"
    },
    {
      "text": "完成订阅并发起真实往返测试；只有同一凭据读取原消息并回传校验回复后才显示可用。"
    }
  ],
  "configuration": [
    {
      "key": "endpointMode",
      "label": "ChatGPT 入口类型",
      "kind": "select",
      "required": true,
      "options": [
        {
          "value": "long-lived",
          "label": "长期公网入口"
        },
        {
          "value": "temporary",
          "label": "临时公网入口"
        }
      ],
      "description": "选择已有的长期公网入口，或让 Dot 自动创建最长 24 小时的临时入口。"
    },
    {
      "key": "longLivedServerUrlTemplate",
      "label": "长期公网入口地址",
      "kind": "string",
      "required": true,
      "description": "指向 Host 通用插件转发路径的完整 HTTPS URL，必须且只能包含一次 {token}；例如 https://host.example/api/plugin-runtime/handle?token={token}。"
    },
    {
      "key": "externalTokenDays",
      "label": "外部凭据有效天数",
      "kind": "number",
      "required": false,
      "default": 180,
      "description": "1–180 天；Dot 会在到期前提示更新。"
    },
    {
      "key": "temporaryEndpointHours",
      "label": "临时入口有效小时数",
      "kind": "number",
      "required": false,
      "default": 1,
      "description": "最长 24 小时；到期、停用或卸载会自动关闭。"
    },
    {
      "key": "longLivedEndpoint",
      "label": "长期公网入口",
      "kind": "operation",
      "required": false,
      "target": ["longLivedServerUrlTemplate"],
      "actions": [
        {
          "id": "use-long-lived",
          "label": "生成 Server URL",
          "render": "button",
          "resultRender": "text",
          "confirm": "确认签发新的外部凭据并生成 Server URL？",
          "action": {
            "method": "dot.use-long-lived"
          }
        }
      ]
    },
    {
      "key": "temporaryEndpoint",
      "label": "临时公网入口",
      "kind": "operation",
      "required": false,
      "actions": [
        {
          "id": "start-temporary",
          "label": "创建临时入口",
          "render": "button",
          "resultRender": "text",
          "confirm": "确认启动一个有时限的临时公网入口？",
          "action": {
            "method": "dot.start-temporary"
          }
        }
      ]
    },
    {
      "key": "webhookProxyUrl",
      "label": "回调代理（可选）",
      "kind": "string",
      "required": false,
      "description": "仅支持本机 HTTP CONNECT 代理；留空直接连接。保存后更新连接。"
    },
    {
      "key": "connection",
      "label": "Dot 连接",
      "kind": "operation",
      "required": false,
      "actions": [
        {
          "id": "status",
          "label": "刷新状态",
          "render": "status",
          "resultRender": "rows",
          "action": {
            "method": "dot.status"
          }
        },
        {
          "id": "show-server-url",
          "label": "显示并复制 Server URL",
          "render": "row",
          "resultRender": "text",
          "action": {
            "method": "dot.show-server-url"
          }
        },
        {
          "id": "refresh-credential",
          "label": "更新外部凭据",
          "render": "row",
          "resultRender": "text",
          "confirm": "确认签发并验证新的外部凭据？现有凭据会保留到新凭据验证成功。",
          "action": {
            "method": "dot.refresh-credential"
          }
        },
        {
          "id": "cancel-pending",
          "label": "放弃本次更新",
          "render": "row",
          "resultRender": "rows",
          "confirm": "放弃待验证的新凭据并关闭对应临时入口？现有凭据不会被替换。",
          "action": {
            "method": "dot.cancel-pending"
          }
        },
        {
          "id": "begin-pairing",
          "label": "生成配对说明",
          "render": "row",
          "resultRender": "rows",
          "confirm": "确认生成一次新的 Dot 配对说明？",
          "action": {
            "method": "dot.begin-pairing"
          }
        },
        {
          "id": "show-instructions",
          "label": "复制配对说明",
          "render": "row",
          "action": {
            "method": "dot.show-instructions"
          }
        },
        {
          "id": "reconnect",
          "label": "重新生成配对说明",
          "render": "row",
          "resultRender": "rows",
          "confirm": "这会撤销旧配对，旧召唤将不能继续回复。",
          "action": {
            "method": "dot.reconnect"
          }
        },
        {
          "id": "disconnect",
          "label": "断开连接",
          "render": "row",
          "resultRender": "rows",
          "confirm": "断开后无法接收召唤，已保存的消息和原图保留。",
          "action": {
            "method": "dot.disconnect"
          }
        },
        {
          "id": "roundtrip",
          "label": "发起往返测试",
          "render": "row",
          "resultRender": "rows",
          "action": {
            "method": "dot.roundtrip"
          }
        },
        {
          "id": "check-roundtrip",
          "label": "检查测试结果",
          "render": "row",
          "resultRender": "rows",
          "action": {
            "method": "dot.check-roundtrip"
          }
        }
      ]
    }
  ],
  "configurationVariants": {
    "discriminator": "endpointMode",
    "branches": [
      {
        "id": "long-lived",
        "when": {
          "properties": {
            "endpointMode": {
              "const": "long-lived"
            }
          }
        },
        "fields": ["longLivedServerUrlTemplate", "externalTokenDays", "longLivedEndpoint"]
      },
      {
        "id": "temporary",
        "when": {
          "properties": {
            "endpointMode": {
              "const": "temporary"
            }
          }
        },
        "fields": ["temporaryEndpointHours", "temporaryEndpoint"]
      }
    ]
  },
  "test": {
    "action": {
      "method": "dot.test"
    }
  },
  "contributions": [
    {
      "type": "identity",
      "id": "dot",
      "displayName": "Dot"
    },
    {
      "type": "webhook",
      "id": "dot-original",
      "path": "images/:imageId",
      "methods": ["GET"]
    },
    {
      "type": "media-source",
      "id": "dot-images",
      "binding": "dot"
    },
    {
      "type": "external-request",
      "id": "dot-mcp"
    }
  ],
  "features": [
    {
      "id": "dot-connection",
      "name": "Dot 配对与对话",
      "resources": [],
      "contributions": [
        {
          "type": "identity",
          "id": "dot"
        },
        {
          "type": "webhook",
          "id": "dot-original"
        },
        {
          "type": "media-source",
          "id": "dot-images"
        },
        {
          "type": "external-request",
          "id": "dot-mcp"
        }
      ],
      "capabilities": [
        "plugin.config.read",
        "plugin.state.get",
        "plugin.state.set",
        "messaging.send",
        "message.event.subscribe",
        "streams.read",
        "thread.listMetadata",
        "thread.readContent",
        "thread.write"
      ]
    }
  ],
  "data": [
    {
      "name": "dot-connection",
      "dataClass": "relationship",
      "strategy": "retained",
      "schemaVersion": "1"
    },
    {
      "name": "dot-dispatch",
      "dataClass": "interaction-history",
      "strategy": "retained",
      "schemaVersion": "1"
    },
    {
      "name": "dot-images",
      "dataClass": "derived-user-visible",
      "strategy": "retained",
      "schemaVersion": "1"
    }
  ],
  "runtime": {
    "transport": "builtin",
    "entrypoint": "dist/plugin-entrypoint.js"
  }
}
