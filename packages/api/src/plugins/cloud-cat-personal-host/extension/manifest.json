{
  "manifest_version": 3,
  "name": "Clowder AI Personal ChatGPT Pro",
  "version": "0.2.5",
  "description": "Owner-authorized append bridge for personal ChatGPT conversations.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://chatgpt.com/c/*"],
  "icons": {
    "16": "icons/gpt-pro-16.png",
    "32": "icons/gpt-pro-32.png",
    "48": "icons/gpt-pro-48.png",
    "128": "icons/gpt-pro-128.png"
  },
  "action": {
    "default_title": "授权此会话",
    "default_icon": {
      "16": "icons/gpt-pro-16.png",
      "32": "icons/gpt-pro-32.png",
      "48": "icons/gpt-pro-48.png",
      "128": "icons/gpt-pro-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/c/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
