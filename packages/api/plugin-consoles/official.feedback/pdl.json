{
  "ns": "feedback",
  "inserts": [
    {
      "id": "feedback",
      "anchor": "inbox",
      "at": "before",
      "node": {
        "title": "t:feedback.plugin.entry",
        "icon": "msg",
        "open": {
          "node": "feedback.panel",
          "anchor": "panel",
          "as": "beside"
        }
      }
    }
  ],
  "views": {
    "feedback.panel": {
      "vm": "feedbackPanel",
      "loading": "t:feedback.load.loading",
      "error": "t:feedback.load.error",
      "blocks": [
        {
          "type": "frame",
          "html": "$.html",
          "key": "feedback",
          "tall": true,
          "title": "t:feedback.plugin.entry",
          "on": {
            "message": "feedbackMessage"
          }
        }
      ],
      "panel": ["t:feedback.plugin.entry", "msg", "", "other", "t:feedback.plugin.desc"]
    }
  }
}
