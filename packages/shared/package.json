{
  "name": "@cat-cafe/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./registry": {
      "import": "./dist/registry/index.js",
      "types": "./dist/registry/index.d.ts"
    },
    "./dossier": {
      "import": "./dist/dossier/index.js",
      "types": "./dist/dossier/index.d.ts"
    },
    "./scanner-discovery-pure": {
      "import": "./dist/scanner-discovery-pure.js",
      "types": "./dist/scanner-discovery-pure.d.ts"
    },
    "./profile-frontmatter-parser": {
      "import": "./dist/profile-frontmatter-parser.js",
      "types": "./dist/profile-frontmatter-parser.d.ts"
    },
    "./profile-contract": {
      "import": "./dist/profile-contract.js",
      "types": "./dist/profile-contract.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ioredis": "^5.3.0",
    "yaml": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
