      "example": "loaded-runtime:sha256:1414141414141414141414141414141414141414141414141414141414141414"
    },
    "freshnessProof": {
      "pattern": "^freshness-proof:sha256:[0-9a-f]{64}$",
      "example": "freshness-proof:sha256:1515151515151515151515151515151515151515151515151515151515151515"
    },
    "rollbackReceipt": {
      "pattern": "^rollback-receipt:sha256:[0-9a-f]{64}$",
      "example": "rollback-receipt:sha256:1616161616161616161616161616161616161616161616161616161616161616"
    },
    "restoreOutcome": {
      "pattern": "^restore-outcome:sha256:[0-9a-f]{64}$",
      "example": "restore-outcome:sha256:1717171717171717171717171717171717171717171717171717171717171717"
    },
    "restoreOutcomeAttempt": {
      "pattern": "^restore-outcome-attempt:sha256:[0-9a-f]{64}$",
      "example": "restore-outcome-attempt:sha256:1818181818181818181818181818181818181818181818181818181818181818"
    },
    "restoreExecutionAttempt": {
      "pattern": "^restore-execution-attempt:sha256:[0-9a-f]{64}$",
      "example": "restore-execution-attempt:sha256:1919191919191919191919191919191919191919191919191919191919191919"
    },
    "rollback": {
      "pattern": "^hf-space:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+@[0-9a-f]{40}#[^\\s]+\\.onnx$",
      "example": "hf-space:pollen-robotics/microduck-simulator@183f99a40bd7308da3e848de961ed32bb02624a5#app/public/policies/BEST_alpha_walking.onnx"
    },
    "capture": {
      "pattern": "^capture:sha256:[0-9a-f]{64}$",
      "example": "capture:sha256:5555555555555555555555555555555555555555555555555555555555555555"
    },
    "holdoutSealedProof": {
      "pattern": "^evaluation-proof:sha256:[0-9a-f]{64}$",
      "example": "evaluation-proof:sha256:6666666666666666666666666666666666666666666666666666666666666666"
    },
    "optimizerExposureProof": {
      "pattern": "^exposure-proof:sha256:[0-9a-f]{64}$",
      "example": "exposure-proof:sha256:7777777777777777777777777777777777777777777777777777777777777777"
    }
  }
}
